# =================================================================
# DevCollab Server Environment Variables
# =================================================================

# 1. Server Port (Default is 3000)
PORT=3000

# 2. MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/devcollab?retryWrites=true&w=majority
MONGO_URL=your_mongodb_connection_string_here

# 3. JWT Secret Key (Any random secure secret string for cryptographic token signing)
# Example: devcollab_super_secret_jwt_key_2026_xyz
JWT_SECRET=your_jwt_secret_key_here

# 4. Cloudinary Credentials (Required for avatar photo uploads)
# Found in your Cloudinary Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
